+// Plether's private Nitro gateway expects a bearer token on its primary RPC.
+// Keep the token out of the Alto config and never attach it to a distinct
+// transaction relay URL.
+export function getPrimaryRpcAuthToken(): string | undefined {
+    const token = process.env.PLETHER_ALTO_RPC_AUTH_TOKEN
+    if (token === undefined) return undefined
+    if (token.length < 32 || token.length > 512 || !/^[\x21-\x7e]+$/.test(token)) {
+        throw new Error("PLETHER_ALTO_RPC_AUTH_TOKEN is malformed")
+    }
+    return token
+}
+
+export function primaryRpcFetchOptions(
+    primaryUrl: string,
+    requestUrl: string,
+    token: string | undefined
+): HttpTransportConfig["fetchOptions"] {
+    return token !== undefined && requestUrl === primaryUrl
+        ? { headers: { Authorization: `Bearer ${token}` } }
+        : undefined
+}
