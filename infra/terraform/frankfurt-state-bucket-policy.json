{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RequireTls",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::plether-sepolia-aa-temp-tfstate-932542905614",
        "arn:aws:s3:::plether-sepolia-aa-temp-tfstate-932542905614/*"
      ],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    },
    {
      "Sid": "RestrictStateToOperatorAndAccountRecovery",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::plether-sepolia-aa-temp-tfstate-932542905614",
        "arn:aws:s3:::plether-sepolia-aa-temp-tfstate-932542905614/*"
      ],
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": [
            "arn:aws:iam::932542905614:user/plether-admin",
            "arn:aws:iam::932542905614:root"
          ]
        }
      }
    }
  ]
}
