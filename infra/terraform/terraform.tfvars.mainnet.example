aws_region          = "us-east-1"
environment         = "mainnet"
# Replace the example account ID with the account that owns the operations topic.
operations_alarm_sns_topic_arn = "arn:aws:sns:us-east-1:123456789012:plether-mainnet-operations"
posthog_project_token = "phc_YOUR_POSTHOG_PROJECT_TOKEN"
posthog_otlp_host     = "eu.i.posthog.com"
rpc_url                        = "https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY"
perps_rpc_url                  = "https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY"
keeper_private_key             = "0xYOUR_KEEPER_PRIVATE_KEY"
oracle_updater_private_key     = "0xYOUR_ORACLE_UPDATER_PRIVATE_KEY"
liquidation_keeper_private_key = "0xYOUR_LIQUIDATION_KEEPER_PRIVATE_KEY"
enable_aa_sponsorship          = false # Perps managed sponsorship is Sepolia-only.
pyth_api_key                    = "PYTH_API_KEY_WITH_FX_FEED_ACCESS"
enable_pyth_api_key             = true
pyth_latest_max_age_seconds     = "10"
db_password         = "CHANGE_ME_STRONG_PASSWORD"
db_username         = "plether"
chain_id            = "1"
cors_origins        = "*"
# Keep disabled until a mainnet release is indexed, audited, and reconciled.
protocol_explorer_enabled = false
indexer_start_block = "24427188"
perps_chain_id      = "421614"
perps_indexer_start_block = "273137426"
consolidate_workers = true
# At least one consolidated worker is required before enabling candle dual
# writes; it owns both the basket source watermark and Perps volume indexer.
workers_desired_count = 1
liquidation_worker_desired_count = 0
api_container_cpu   = 512
api_container_memory = 1024
container_cpu       = 256
container_memory    = 1024
workers_container_memory = 1024
db_instance_class          = "db.t4g.small"
# Re-size from measured mainnet demand before first creation; allocated storage
# cannot be reduced in place.
db_allocated_storage       = 20
# Desired final/new-instance type. Preserve a live gp2 value until any pending
# retention/PITR activation completes, then plan gp3 separately.
db_storage_type            = "gp3"
db_storage_encrypted       = false
db_kms_key_id              = ""
db_ssl_root_cert_path      = "/etc/ssl/certs/aws-rds-global-bundle.pem"
db_ca_cert_identifier      = "rds-ca-rsa2048-g1"
db_apply_immediately       = false
db_backup_retention_days   = 7
db_max_allocated_storage   = 100
db_deletion_protection     = true
db_skip_final_snapshot     = false
# Must be unique in this AWS region for the current DB lifecycle. Choose a new
# suffix before recreating the instance so the prior final snapshot is retained.
db_final_snapshot_identifier = "plether-mainnet-final-20260812-a"

# Mainnet remains on legacy reads until dual-write soak, backfill, comparison,
# and load-test gates have passed for every canonical resolution.
perps_candle_write_mode                 = "off"
perps_candle_read_mode                  = "legacy"
perps_candle_read_intervals             = ""
perps_candle_shadow_sample_bps          = 0
perps_candle_strict_coverage            = true
perps_candle_lateness_seconds           = 120
perps_candle_finalization_grace_seconds = 15
