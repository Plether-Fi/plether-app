      "dependsOn": [{"containerName": "image-drill-init", "condition": "SUCCESS"}, {"containerName": "otel-log-router", "condition": "START"}]
    },
    "init": {
      "name": "image-drill-init",
      "command": ["node", "-e", "process.exit(0)"]
    },
    "router": {
      "name": "otel-log-router",
      "entryPoint": ["/bin/sh", "-c"],
      "command": ["exec sleep 86400"]
    }
  }
