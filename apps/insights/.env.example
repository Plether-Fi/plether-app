# Local backend used by Vite's same-origin /api/insights/v1 proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Local-development compatibility for a deployed backend that predates the
# Protocol Explorer bootstrap endpoint. Only a 404 from that endpoint falls
# back to the competition; other bootstrap failures remain visible.
VITE_PROTOCOL_EXPLORER_LEGACY_FALLBACK=false
