# Plether Frontend Environment Variables

# Public Reown project ID used by AppKit and WalletConnect.
VITE_WALLETCONNECT_PROJECT_ID=ac255192981643094de1bdfd0f501d55

# Arbitrum Sepolia RPC URL (required for perps fork tests)
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY

# Browser-facing Arbitrum Sepolia RPC URL. Optional, but recommended for local
# perps trading because the public Arbitrum endpoint can fail in browsers.
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional browser-facing Ethereum endpoints. Leave unset to use viem's public
# chain transports; production Alchemy URLs must use a domain-restricted app.
VITE_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional testnet override for the browser-visible managed-sponsorship
# manifest shipped from `public/perps-aa-manifest.json`. Testnet deployments
# use this bundled path by default. It selects the testnet-only
# permissionless.js SimpleAccount v0.8 integration and a same-origin
# `/api/perps/v1/aa/...` Pimlico proxy. It must never contain a Pimlico API
# key or sponsorship-policy ID; the backend injects those.
VITE_PERPS_AA_MANIFEST_URL=/perps-aa-manifest.json

# Local fork test wallet private key. This account must hold testnet USDC
# if the fork tests need to deposit fresh margin.
TEST_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Backend API URL used by perps fork tests to fetch Pyth update data.
PERPS_FORK_API_URL=http://127.0.0.1:3001/api

# Ethereum Sepolia RPC URL (required for legacy Anvil integration tests)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# API base URL (optional, for local direct-backend development only)
# When set, overrides product-scoped API path routing for both spot and perps.
# In production, leave unset — the frontend uses browser-facing product namespaces:
#   spot  → /api/spot/v1
#   perps → /api/perps/v1
VITE_API_URL=http://localhost:3001/api

# Production build default chain. Mainnet app uses 1; the managed Perps
# testnet app uses Arbitrum Sepolia 421614. API routing is product-scoped and
# does not follow wallet chain.
VITE_DEFAULT_CHAIN_ID=1

# Dev-server API proxy target (optional). Used when VITE_API_URL is unset.
# Defaults to http://127.0.0.1:3001. For Sepolia parity, set this to the
# actual backend origin configured in the Cloudflare worker as SEPOLIA_BACKEND_URL,
# not the app.sepolia.plether.com frontend URL.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Server-side only. Used by the local Vite proxy for /api/perps/v1/aa/pimlico
# and must match the backend's origin token. Never prefix this with VITE_.
AA_PROXY_ORIGIN_TOKEN=replace-with-a-local-shared-secret

# Server-side only. Used by the local Vite proxy for the exact Sepolia faucet
# route and must match the backend's dedicated faucet origin token.
FAUCET_PROXY_ORIGIN_TOKEN=replace-with-a-different-local-shared-secret

# Optional: cached DB oracle updater worker. This worker does not call Hermes;
# it reads the backend's cached /api/perps/pyth/cached-latest payload. Use a
# dedicated funded key that is not shared with the order or liquidation keeper.
PERPS_ORACLE_UPDATER_BACKEND_URL=http://127.0.0.1:3001
PERPS_ORACLE_UPDATER_PRIVATE_KEY=0xYOUR_ORACLE_UPDATER_PRIVATE_KEY
PERPS_ORACLE_UPDATER_POLL_SECONDS=300
PERPS_ORACLE_UPDATER_MAX_PAYLOAD_AGE_SECONDS=50

# Optional anonymous Perps product analytics. Leave VITE_POSTHOG_KEY unset to
# disable analytics entirely. The integration uses EU Cloud and disabled
# persistence by default.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_REPLAY_SAMPLE_RATE=0.05
VITE_DEPLOYMENT_ENV=development

# TradingView Advanced Charts. Licensed assets are installed separately into
# public/charting_library and must never be committed to this repository.
VITE_TRADINGVIEW_LIBRARY_PATH=/charting_library/
