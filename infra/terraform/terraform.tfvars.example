aws_region                       = "us-east-1"
environment                      = "sepolia"
posthog_project_token            = "phc_YOUR_POSTHOG_PROJECT_TOKEN"
posthog_otlp_host                = "eu.i.posthog.com"
rpc_url                          = "https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY"
perps_rpc_url                    = "https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY"
keeper_private_key               = "0xYOUR_KEEPER_PRIVATE_KEY"
oracle_updater_private_key        = "0xYOUR_ORACLE_UPDATER_PRIVATE_KEY"
liquidation_keeper_private_key   = "0xYOUR_LIQUIDATION_KEEPER_PRIVATE_KEY"
provision_aa_proxy             = true
enable_aa_sponsorship          = true
pimlico_api_key                = "pim_YOUR_PIMLICO_API_KEY"
pimlico_sponsorship_policy_id = "sp_YOUR_POLICY_ID"
aa_proxy_origin_token          = "GENERATE_A_LONG_RANDOM_SHARED_SECRET"
alb_certificate_arn            = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"
api_hostname                   = "api.sepolia.plether.com"
pyth_hermes_url                 = "https://pyth.dourolabs.app/hermes"
pyth_api_key_ssm_parameter_name = "/plether/sepolia/pyth-api-key"
pyth_latest_max_age_seconds     = "10"
db_password                     = "CHANGE_ME_STRONG_PASSWORD"
db_username                     = "plether"
chain_id                        = "11155111"
cors_origins                    = "https://testnet.plether.fi"
indexer_start_block             = "10188700"
perps_chain_id                  = "421614"
perps_indexer_start_block = "273137426"
liquidation_worker_poll_seconds     = "600"
liquidation_worker_scan_batch_size  = "1000"
liquidation_worker_multicall_size   = "10"
liquidation_worker_confirmations    = "1"
liquidation_worker_index_batch_size = "5000"
liquidation_worker_reorg_overlap_blocks = "12"
liquidation_worker_pending_replacement_seconds = "120"
liquidation_worker_desired_count     = 1
api_container_cpu   = 512
container_cpu       = 256
container_memory    = 1024
db_instance_class   = "db.t4g.medium"
db_allocated_storage = 40
# Desired final/new-instance type. Keep an existing gp2 instance on gp2 until
# backup retention and PITR are active, then plan the gp3 conversion separately.
db_storage_type      = "gp3"
db_apply_immediately = false
db_backup_retention_days = 7
db_max_allocated_storage = 100
db_deletion_protection   = true
db_skip_final_snapshot   = false
# Must be unique in this AWS region for the current DB lifecycle. Choose a new
# suffix before recreating the instance so the prior final snapshot is retained.
db_final_snapshot_identifier = "plether-sepolia-final-20260812-a"

# Keep these safe during the additive schema deployment. Enable dual writes and
# rollup reads only after the environment's migration and coverage checks pass.
perps_candle_write_mode                 = "off"
perps_candle_read_mode                  = "legacy"
perps_candle_read_intervals             = ""
perps_candle_shadow_sample_bps          = 0
perps_candle_strict_coverage            = true
perps_candle_lateness_seconds           = 120
perps_candle_finalization_grace_seconds = 15
