# Local backend used by Vite's same-origin /api/insights/v1 proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Optional privacy-safe product analytics. No wallet, P&L, search text, or account identity is sent.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_REPLAY_SAMPLE_RATE=0.05
