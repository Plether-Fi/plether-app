# Plether Frontend Environment Variables

# Arbitrum Sepolia RPC URL (required for perps fork tests)
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY

# Browser-facing Arbitrum Sepolia RPC URL. Optional, but recommended for local
# perps trading because the public Arbitrum endpoint can fail in browsers.
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY

# Local fork test wallet private key. This account must hold testnet USDC
# if the fork tests need to deposit fresh margin.
TEST_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Backend API URL used by perps fork tests to fetch Pyth update data.
PERPS_FORK_API_URL=http://127.0.0.1:3001/api

# Ethereum Sepolia RPC URL (required for legacy Anvil integration tests)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# API base URL (optional, for local development only)
# When set, overrides chain-based API path routing.
# In production, leave unset — the frontend derives the path from the wallet's chain ID:
#   mainnet (chain 1)     → /api/v1
#   sepolia (chain 11155111) → /api/sepolia_v1
VITE_API_URL=http://localhost:3001/api

# Production build default before wallet chain sync. Mainnet app uses 1;
# separate testnet app should use 11155111.
VITE_DEFAULT_CHAIN_ID=1

# Dev-server API proxy target (optional). Used when VITE_API_URL is unset.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Optional: cached DB oracle updater worker. This worker does not call Hermes;
# it reads the backend's cached /api/perps/pyth/cached-latest payload.
PERPS_ORACLE_UPDATER_BACKEND_URL=http://127.0.0.1:3001
PERPS_ORACLE_UPDATER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
PERPS_ORACLE_UPDATER_POLL_SECONDS=300
PERPS_ORACLE_UPDATER_MAX_PAYLOAD_AGE_SECONDS=50
