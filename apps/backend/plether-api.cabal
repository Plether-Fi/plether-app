cabal-version:      3.0
name:               plether-api
version:            0.1.0.0
synopsis:           Plether DeFi Backend API
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Plether
maintainer:         dev@plether.io
category:           Web
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wmissing-export-lists
                 -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints

library
    import:           warnings
    exposed-modules:
        Plether.Api
        Plether.Cache
        Plether.Config
        Plether.Types
        Plether.Types.Api
        Plether.Types.Protocol
        Plether.Types.User
        Plether.Types.Quote
        Plether.Types.Perps
        Plether.Types.Error
        Plether.Handlers.Protocol
        Plether.Handlers.Perps
        Plether.Handlers.User
        Plether.Handlers.Quote
        Plether.Ethereum.Client
        Plether.Ethereum.Multicall
        Plether.Ethereum.Abi
        Plether.Ethereum.Rlp
        Plether.Ethereum.Rpc
        Plether.Ethereum.Transaction
        Plether.Ethereum.Contracts.ERC20
        Plether.Ethereum.Contracts.SyntheticSplitter
        Plether.Ethereum.Contracts.BasketOracle
        Plether.Ethereum.Contracts.StakedToken
        Plether.Ethereum.Contracts.Morpho
        Plether.Ethereum.Contracts.MorphoOracle
        Plether.Ethereum.Contracts.MorphoIrm
        Plether.Ethereum.Contracts.CurvePool
        Plether.Ethereum.Contracts.LeverageRouter
        Plether.Ethereum.Contracts.ZapRouter
        Plether.Ethereum.Contracts.Perps
        Plether.Utils.Address
        Plether.Utils.Hex
        Plether.Utils.Numeric
        Plether.Database
        Plether.Database.Schema
        Plether.Pyth.Basket
        Plether.Pyth.Hermes
        Plether.Pyth.History
        Plether.Pyth.RevealPayload
        Plether.Perps.HistoryIndexer
        Plether.Types.History
        Plether.Indexer
        Plether.Indexer.Contracts
        Plether.Indexer.Events
        Plether.Handlers.History
        Plether.Keeper
        Plether.Handlers.PerpsHistory
        Plether.Handlers.TestnetFaucet
    build-depends:
        base >= 4.17 && < 5,
        scotty >= 0.22,
        warp >= 3.3,
        wai >= 3.2,
        wai-cors >= 0.2,
        wai-extra >= 3.1,
        aeson >= 2.1,
        http-client >= 0.7,
        http-client-tls >= 0.3,
        bytestring >= 0.11,
        text >= 2.0,
        base16-bytestring >= 1.0,
        crypton >= 0.34,
        memory >= 0.18,
        scientific >= 0.3,
        mtl >= 2.3,
        transformers >= 0.6,
        containers >= 0.6,
        stm >= 2.5,
        time >= 1.12,
        http-types >= 0.12,
        vector >= 0.13,
        postgresql-simple >= 0.7,
        resource-pool >= 0.4
    pkgconfig-depends:
        libsecp256k1
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
        DeriveGeneric
        DeriveAnyClass
        DerivingStrategies
        GeneralizedNewtypeDeriving
        LambdaCase
        RecordWildCards
        TypeApplications
        DataKinds

executable plether-api
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >= 4.17 && < 5,
        plether-api,
        scotty >= 0.22,
        text >= 2.0,
        http-client >= 0.7,
        http-client-tls >= 0.3
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

executable plether-basket-worker
    import:           warnings
    main-is:          BasketWorker.hs
    build-depends:
        base >= 4.17 && < 5,
        plether-api,
        aeson >= 2.1,
        text >= 2.0,
        http-client >= 0.7,
        http-client-tls >= 0.3
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

executable plether-keeper
    import:           warnings
    main-is:          Keeper.hs
    build-depends:
        base >= 4.17 && < 5,
        plether-api,
        text >= 2.0
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

executable plether-perps-indexer
    import:           warnings
    main-is:          PerpsIndexer.hs
    build-depends:
        base >= 4.17 && < 5,
        plether-api,
        text >= 2.0,
        http-client >= 0.7,
        http-client-tls >= 0.3
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

test-suite plether-api-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    other-modules:
        Plether.Utils.NumericSpec
        Plether.Utils.AddressSpec
        Plether.Ethereum.AbiSpec
        Plether.Ethereum.MulticallSpec
        Plether.Ethereum.Contracts.PerpsSpec
        Plether.Ethereum.TransactionSpec
        Plether.Indexer.ContractsSpec
        Plether.Indexer.EventsSpec
        Plether.Handlers.PerpsHistorySpec
        Plether.Handlers.TestnetFaucetSpec
        Plether.KeeperSpec
        Plether.Pyth.RevealPayloadSpec
        Plether.Perps.HistoryIndexerSpec
        Plether.Types.ProtocolSpec
        Plether.Types.PerpsSpec
    build-depends:
        base >= 4.17 && < 5,
        plether-api,
        hspec >= 2.11,
        hspec-discover >= 2.11,
        QuickCheck >= 2.14,
        aeson >= 2.1,
        bytestring >= 0.11,
        text >= 2.0,
        base16-bytestring >= 1.0
    build-tool-depends:
        hspec-discover:hspec-discover >= 2.11
    hs-source-dirs:   test
    default-language: GHC2021
    default-extensions:
        OverloadedStrings
