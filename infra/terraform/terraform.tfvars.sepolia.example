aws_region                       = "ap-southeast-1"
expected_aws_account_id          = "932542905614"
environment                      = "sepolia"
posthog_project_token            = "phc_YOUR_POSTHOG_PROJECT_TOKEN"
posthog_otlp_host                = "eu.i.posthog.com"
rpc_url                          = "https://eth-sepolia.g.alchemy.com/v2"
perps_rpc_url                    = "https://arb-sepolia.g.alchemy.com/v2"
# Provision these SecureStrings outside Terraform; only their names enter state.
rpc_auth_token_ssm_parameter_name       = "/plether/sepolia/rpc-auth-token"
perps_rpc_auth_token_ssm_parameter_name = "/plether/sepolia/perps-rpc-auth-token"
# Vault history and activity use perps_rpc_url. Terraform retains the old
# vault-history-rpc-url SecureString without consuming or rotating its value
# until the separate post-soak removal apply.
keeper_private_key               = "0xYOUR_KEEPER_PRIVATE_KEY"
lp_settlement_private_key         = "" # Set a unique funded key before observe/execute.
lp_settlement_signer_funding_confirmed = false # Set true only after funding and a successful keeper preflight.
oracle_updater_private_key        = "0xYOUR_ORACLE_UPDATER_PRIVATE_KEY"
liquidation_keeper_private_key   = "0xYOUR_LIQUIDATION_KEEPER_PRIVATE_KEY"
faucet_private_key             = "0xYOUR_FAUCET_PRIVATE_KEY"
faucet_proxy_origin_token      = "GENERATE_A_DEDICATED_RANDOM_32_BYTE_SHARED_SECRET"
faucet_client_requests_per_hour = 20
faucet_global_requests_per_hour = 200
provision_aa_proxy             = true
enable_aa_sponsorship          = false # Enable only after the bounded-V2 backend passes its readiness probe.
pimlico_api_key                = "pim_YOUR_PIMLICO_API_KEY"
pimlico_sponsorship_policy_id = "sp_YOUR_POLICY_ID"
aa_proxy_origin_token          = "GENERATE_A_LONG_RANDOM_SHARED_SECRET"
provision_insights_registration = true
# Keep false until the September competition slug is activated and the
# identical origin token is configured as the
# INSIGHTS_REGISTRATION_ORIGIN_TOKEN GitHub Actions secret for Pages. The
# competition contract release may be bound later.
enable_insights_registration                    = false
insights_registration_public_origin             = "https://insights.plether.com"
insights_registration_origin_token              = "REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_TOKEN"
# Optional rotation overlap token. Keep empty outside an active rotation and
# make it distinct from insights_registration_origin_token when set.
insights_registration_origin_token_next         = ""
turnstile_secret_key                            = "REPLACE_WITH_TURNSTILE_SECRET_KEY"
turnstile_expected_hostname                     = "insights.plether.com"
turnstile_expected_action                       = "competition_registration"
x_oauth_client_id                               = "REPLACE_WITH_X_OAUTH_CLIENT_ID"
x_oauth_client_secret                           = "REPLACE_WITH_X_OAUTH_CLIENT_SECRET"
x_oauth_callback_url                            = "https://insights.plether.com/api/insights/v1/competitions/testnet-trading-2026-09/registrations/x/callback"
x_target_user_id                                 = "123456789" # Replace with @plether_fi's stable numeric ID.
x_target_handle                                  = "plether_fi"
# Generate each key independently with: openssl rand -base64 32
# Never remove an old email key version until all rows have been re-encrypted.
insights_registration_email_keys = {
  v1 = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
}
insights_registration_email_key_version          = "v1"
insights_registration_email_hmac_key_base64      = "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB="
insights_registration_session_ttl_seconds         = 1800
insights_registration_ip_rate_limit_per_minute    = 10
insights_registration_session_rate_limit_per_minute = 30
insights_registration_rules_version               = "2026-09-13"
insights_registration_privacy_version             = "2026-09-13"
# Registration-only activation: set the competition slug and leave the release
# ID empty until the new contracts are deployed.
# insights_active_competition_slug = "testnet-trading-2026-09"
# One-time release binding: after replacing every pinned July value below with
# the reviewed manifest (including perps_indexer_start_block), set this ID to
# the exact competition slug.
# insights_competition_release_id  = "testnet-trading-2026-09"
