    "routerImage": "932542905614.dkr.ecr.ap-southeast-1.amazonaws.com/plether-otel-log-router-sepolia@sha256:0d73648aa212540a743844179ca40a42806b9c001714ddfd1a8c786d96148ea1",
    "qualificationScope": "Only the built-in Node heartbeat, successful Node init and idle sleep commands below. This record does not qualify a financial service or expand the production recovery catalog.",
