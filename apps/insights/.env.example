# Local backend used by Vite's same-origin /api/insights/v1 proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:3001

# Public Cloudflare Turnstile site key for the registration spam check.
VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# Public Privy app ID shared with the Arbitrum Sepolia trading frontend.
# Leave blank to browse locally with wallet connection disabled. Never expose
# the Privy app secret or any OAuth provider secret with a VITE_ prefix.
VITE_PRIVY_APP_ID=cmuvplk2t00770ci3895ggus2
# Optional public Insights app client ID for origin and session configuration.
VITE_PRIVY_CLIENT_ID=

# Browser-facing RPC used only for Arbitrum Sepolia wallet connectivity.
# Keep this origin aligned with the Pages worker Content-Security-Policy.
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
