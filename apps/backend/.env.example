# Plether API Backend Environment Variables
# Copy to .env and fill in your values

# Required: Ethereum RPC endpoint. Hosted Alchemy deployments use the keyless
# base URL and send the app key only through Authorization.
RPC_URL=https://eth-sepolia.g.alchemy.com/v2
RPC_AUTH_TOKEN=YOUR_RPC_ACCESS_KEY

# Optional: Chain ID (default: 11155111 for Sepolia)
CHAIN_ID=11155111

# Optional: Server port (default: 3001)
PORT=3001

# Optional: CORS origins (space-separated, default: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Optional: PostgreSQL connection string (enables transaction history)
# If not set, history endpoints are disabled
DATABASE_URL=postgresql://localhost/plether

# Optional: Block to start indexing from (default: 0)
# Set to contract deployment block for faster initial sync
# Sepolia deployment: 10188700 (0x9b779c)
INDEXER_START_BLOCK=10188700

# Optional: Pyth historical basket ingestion for the Perps chart
PYTH_INGESTION_ENABLED=false
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network
PYTH_HISTORY_URL=https://pyth.dourolabs.app/v1
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# Required by the hosted Hermes, Benchmarks, and Pyth Pro History endpoints. Use a server-side key
# entitled to all six configured basket feeds, including the FX feeds.
PYTH_API_KEY=YOUR_PYTH_API_KEY_WITH_FX_FEED_ACCESS
PYTH_BACKFILL_DAYS=7
PYTH_SAMPLE_INTERVAL_SECONDS=60
PYTH_LATEST_MAX_AGE_SECONDS=10

# Incremental OHLCV rollouts are fail-closed. Keep both modes at their defaults
# until migrations, dual-write soak, backfill, and coverage verification finish.
PERPS_CANDLE_WRITE_MODE=off
PERPS_CANDLE_READ_MODE=legacy
# Empty means no public rollup interval is exposed.
PERPS_CANDLE_READ_INTERVALS=
# Reserved; shadow comparison is not active yet.
PERPS_CANDLE_SHADOW_SAMPLE_BPS=0
# Rollup routes fail closed unless strict coverage remains enabled.
PERPS_CANDLE_STRICT_COVERAGE=true
PERPS_CANDLE_LATENESS_SECONDS=120
# Keep this above the writer's 5s poll/commit cadence without changing source lateness.
PERPS_CANDLE_FINALIZATION_GRACE_SECONDS=15

# Optional: Arbitrum Sepolia perps mock USDC faucet signer. Must be funded with
# Arbitrum Sepolia ETH and authorized to mint the deployed perps mock USDC token.
FAUCET_PRIVATE_KEY=0xYOUR_FAUCET_PRIVATE_KEY
FAUCET_PROXY_ORIGIN_TOKEN=replace-with-a-dedicated-32-byte-random-secret
FAUCET_CLIENT_REQUESTS_PER_HOUR=20
FAUCET_GLOBAL_REQUESTS_PER_HOUR=200

# Required for plether-keeper
PERPS_RPC_URL=https://arb-sepolia.g.alchemy.com/v2
PERPS_RPC_AUTH_TOKEN=YOUR_PERPS_RPC_ACCESS_KEY
KEEPER_PRIVATE_KEY=0xYOUR_KEEPER_PRIVATE_KEY
# Required when LP_SETTLEMENT_MODE is observe or execute. Keep this signer
# separate from every order, liquidation, and oracle-updater signer.
# LP_SETTLEMENT_PRIVATE_KEY=0xYOUR_LP_SETTLEMENT_PRIVATE_KEY

# Required for plether-liquidation-worker. Use a separately funded signer to
# avoid nonce contention with the order keeper.
LIQUIDATION_KEEPER_PRIVATE_KEY=0xYOUR_LIQUIDATION_KEEPER_PRIVATE_KEY

# Optional plether-keeper settings
PERPS_CHAIN_ID=421614
# Vault performance identity. The sampler runs with the API whenever
# DATABASE_URL is configured and keeps deployments isolated by these values.
VAULT_HISTORY_HOUSE_POOL_ADDRESS=0x21D52509Bb9b9857DaBc8c7FD36dD7fed9118918
VAULT_HISTORY_SENIOR_VAULT_ADDRESS=0x7Bf2B3d3912b5B8D367987C9ADfC6Bd1216E8129
VAULT_HISTORY_JUNIOR_VAULT_ADDRESS=0x41D785d3BcF4D0e306E491a66Ddb0d938135Cc1c
VAULT_HISTORY_DEPLOYMENT_BLOCK=306119399
# Numeric head offset used for one consistent confirmation policy across vault
# history and activity reads.
VAULT_HISTORY_CONFIRMATIONS=12
PERPS_USDC=0xc3CE8590B7EcDE7454f9D5b51a797bbDe96fe56B
PERPS_ORDER_ROUTER=0xbd2f286efca5F761E21452673ab9b8C14e17aad7
PERPS_ORDER_LIFECYCLE_BOOK=0x616aD381Df40047e9b060a1E85085B3Ed2CC6D3C
PERPS_HOUSE_POOL=0x21D52509Bb9b9857DaBc8c7FD36dD7fed9118918
PERPS_SENIOR_VAULT=0x7Bf2B3d3912b5B8D367987C9ADfC6Bd1216E8129
PERPS_JUNIOR_VAULT=0x41D785d3BcF4D0e306E491a66Ddb0d938135Cc1c
# Configure the v1.2.2 Settlement Monitor facade, never its sidecar.
PERPS_SETTLEMENT_MONITOR_LENS=0xf799Be4f8B5142C052d821F0067ADdFBF9Ce5820
PERPS_PLETHER_ORACLE=0x9e7f0a912a9CB3e1c1d77Ed433F171E23E2D7c87
PERPS_CFD_ENGINE=0x9611E643aC4691E8fDeD8a0c2C22c56438B6f352
PERPS_CFD_ENGINE_LENS=0xE004D20803B484fb62734b78d6144438669Bad18
PERPS_CFD_ENGINE_SETTLEMENT_SIDECAR=0x5CBb5A2f75ea005753a6C0AcCE01f7bB02B668D7
PERPS_MARGIN_CLEARINGHOUSE=0xA863F985EedA8BF5BE2320693BB93d109EBB2dBd
PERPS_ACCOUNT_LENS=0xd949E5987c3d33299dA4Da4d06b064729000d2EB
# Arbitrum Sepolia perps deployment first block (v1.2.2, 2026-09-06).
PERPS_INDEXER_START_BLOCK=306119399
# Exact execution economics require debug_traceTransaction on PERPS_RPC_URL or
# one of the server-side PERPS_INDEXER_RPC_URLS.
INSIGHTS_SNAPSHOT_POLL_SECONDS=60
# Set to 0 to roll back to one direct eth_call per participant.
INSIGHTS_SNAPSHOT_MULTICALL_SIZE=10

# First-party Insights competition registration. Keep disabled until the
# September release addresses above replace every pinned July address and both
# activation guards are set to the exact competition slug.
INSIGHTS_ACTIVE_COMPETITION_SLUG=
INSIGHTS_COMPETITION_RELEASE_ID=
# Provisioning loads and validates the private schema/config without opening
# registration. Activation is a separate one-way database transition.
INSIGHTS_REGISTRATION_PROVISIONED=false
INSIGHTS_REGISTRATION_ENABLED=false
INSIGHTS_REGISTRATION_PUBLIC_ORIGIN=https://insights.plether.com
# Shared only with the canonical Insights Pages Worker. Generate at least 32
# printable, non-whitespace random characters and never expose it via VITE_*.
INSIGHTS_REGISTRATION_ORIGIN_TOKEN=REPLACE_WITH_A_RANDOM_32_BYTE_OR_LONGER_TOKEN
# Optional accept-both overlap token for no-downtime Pages Worker rotation.
INSIGHTS_REGISTRATION_ORIGIN_TOKEN_NEXT=
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
TURNSTILE_EXPECTED_HOSTNAME=insights.plether.com
TURNSTILE_EXPECTED_ACTION=competition_registration
X_OAUTH_CLIENT_ID=REPLACE_WITH_X_OAUTH_CLIENT_ID
X_OAUTH_CLIENT_SECRET=REPLACE_WITH_X_OAUTH_CLIENT_SECRET
X_OAUTH_CALLBACK_URL=https://insights.plether.com/api/insights/v1/competitions/testnet-trading-2026-09/registrations/x/callback
X_TARGET_USER_ID=123456789
X_TARGET_HANDLE=plether_fi
# AES-256-GCM keyring. Generate each value with `openssl rand -base64 32` and
# retain old entries during rotation until all rows have been re-encrypted.
INSIGHTS_REGISTRATION_EMAIL_KEYS_JSON={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
INSIGHTS_REGISTRATION_EMAIL_KEY_VERSION=v1
# Stable uniqueness key. Rotate only together with an explicit digest migration.
INSIGHTS_REGISTRATION_EMAIL_HMAC_KEY_BASE64=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
INSIGHTS_REGISTRATION_SESSION_TTL_SECONDS=1800
INSIGHTS_REGISTRATION_IP_RATE_LIMIT_PER_MINUTE=10
INSIGHTS_REGISTRATION_SESSION_RATE_LIMIT_PER_MINUTE=30
INSIGHTS_REGISTRATION_RULES_VERSION=2026-09-13
INSIGHTS_REGISTRATION_PRIVACY_VERSION=2026-09-13

# Managed Pimlico gas sponsorship. Set all three secrets together; leaving all
# three empty keeps POST /api/aa/pimlico present but fail-closed.
AA_PROXY_ORIGIN_TOKEN=
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=
AA_SPONSORSHIP_ENABLED=false
AA_SPONSOR_PROTECTION_COMMITS_ENABLED=false
AA_IP_RATE_LIMIT_PER_MINUTE=120
AA_ACCOUNT_RATE_LIMIT_PER_MINUTE=30
AA_MAX_REQUEST_BYTES=262144
# Emits a redacted backend alert after unique receipts cross this hourly total.
# Set to 0 to disable the alert.
AA_SPONSORED_GAS_ALERT_WEI_PER_HOUR=0

KEEPER_POLL_SECONDS=1
KEEPER_IDLE_POLL_SECONDS=5
KEEPER_MAX_BATCH_SIZE=20
KEEPER_CONFIRMATIONS=1
KEEPER_GAS_BUFFER_BPS=2000
KEEPER_FEE_BUFFER_BPS=2500
# Deploy in off mode, fund the dedicated signer, run
# `plether-keeper --lp-settlement-preflight`, and soak one full epoch in observe
# mode before using execute. Legacy LP_SETTLEMENT_ENABLED=true is rejected.
LP_SETTLEMENT_MODE=off
LP_SETTLEMENT_POLL_SECONDS=15
LP_SETTLEMENT_MAX_DRAIN_TRANSACTIONS=4
LP_SETTLEMENT_PENDING_REPLACEMENT_SECONDS=60
LP_SETTLEMENT_MAX_REPLACEMENTS=3
# Observe with 0 to measure both cached/atomic transaction costs. Before
# execute, set this to twice the largest observed maximum transaction cost.
LP_SETTLEMENT_MAX_TX_COST_WEI=0

# Optional plether-liquidation-worker settings
LIQUIDATION_WORKER_POLL_SECONDS=600
LIQUIDATION_WORKER_SCAN_BATCH_SIZE=1000
LIQUIDATION_WORKER_MULTICALL_SIZE=10
LIQUIDATION_WORKER_EXECUTION_BATCH_SIZE=20
LIQUIDATION_WORKER_START_BLOCK=273137426
LIQUIDATION_WORKER_CONFIRMATIONS=1
LIQUIDATION_WORKER_INDEX_BATCH_SIZE=5000
LIQUIDATION_WORKER_REORG_OVERLAP_BLOCKS=12
LIQUIDATION_WORKER_PENDING_REPLACEMENT_SECONDS=120
LIQUIDATION_WORKER_GAS_BUFFER_BPS=2000
LIQUIDATION_WORKER_FEE_BUFFER_BPS=2500
