  },
  "containers": {
    "main": {
      "name": "plether-image-recovery-drill",
      "command": ["node", "-e", "const emit=()=>console.log(JSON.stringify({event:'recovery_drill_heartbeat',level:'INFO',container_name:'plether-image-recovery-drill',signingEnabled:false}));emit();setInterval(emit,15000)"],
